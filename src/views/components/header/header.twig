<nav
  id="navbar"
  class="flex py-2 px-2 justify-between items-center transition-all duration-300 fixed w-full z-10"
>
<div class="flex items-center gap-2">
     {#  go to cart #}
     <salla-cart-summary class="ml-4 rtl:ml-[unset] rtl:mr-4">
       <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
    </salla-cart-summary>
    <a href="{{ link('/') }}" class="flex items-center gap-2">
  <img
    class="h-16 max-w-24 object-contain"
    src="{{theme.settings.get('logo')}}"
    alt="logo"
  /></a>

</div>

  <img
    class="h-16 max-w-16"
    src="{{theme.settings.get('image_tow')}}"
    alt="logo"
  />
  <div class="flex items-center justify-end">
    <img
      class="h-16 max-w-16"
      src="{{theme.settings.get('image_one')}}"
      alt="logo"
    />
    
 
  </div>
</nav>

{% if store.scope %}
<salla-scopes
  selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"
></salla-scopes>
{% endif %}

<script>
  document.addEventListener("scroll", function () {
    const navbar = document.getElementById("navbar");
    const scrollPosition = window.scrollY;

    if (scrollPosition > 0) {
      navbar.classList.remove("bg-transparent");
      navbar.classList.add("bg-zinc-900");
      navbar.classList.add("shadow-md"); // Optional: adds a shadow when scrolling
    } else {
      navbar.classList.remove("bg-zinc-900");
      navbar.classList.add("bg-transparent");
      navbar.classList.remove("shadow-md");
    }
  });
</script>
